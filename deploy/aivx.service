# AIVX systemd 单元（部署目标：Debian 12 /opt/aivx）。
# 端口 18443（用户指定）；崩溃自动重启；日志走 journald。
[Unit]
Description=AIVX — AI Video eXtended NVR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aivx
ExecStart=/opt/aivx/aivx
Restart=on-failure
RestartSec=3
# 数据目录：录像/事件库/配置（首次启动生成默认配置）
Environment=AIVX_DATA_DIR=/opt/aivx/data
# 前端静态资源目录
Environment=AIVX_STATIC_DIR=/opt/aivx/static
# ONNX Runtime 动态库（P8b load-dynamic：运行时 dlopen；官方 1.28.2
# linux-x64 包随 bundle 落 /opt/aivx/lib/——ort rc.13 绑 ORT API 1.28）
Environment=ORT_DYLIB_PATH=/opt/aivx/lib/libonnxruntime.so
# 监听端口（用户指定 18443）
Environment=AIVX_PORT=18443
# 资源护栏：CPU 按 8 路 1.5 核预算（DESIGN.md §21）；内存按 YOLO 推理
# 实测定额——768M 被 ort arena + 批输入打爆（16:55 OOM KILL 实证，
# VmPeak 1.6GB），机器 16GB 充裕，提到 1536M。
CPUQuota=200%
MemoryMax=1536M
# 加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aivx
PrivateTmp=true

[Install]
WantedBy=multi-user.target
